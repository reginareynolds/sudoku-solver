# 3x3 grid of squares
<Board@MDGridLayout>:
    # size_hint: 1, 1
    # pos_hint: {"center_x": 0.5, "center_y": 0.5}

    # top: root.top
    # width: root.width
    cols: 3
    rows: 3

    # cols_minimum: {0: 36, 1: 36, 2: 36}
    # cols_default_width: (36)
    #padding: 2
    orientation: 'lr-tb'

    #on_resize: self.on_resize()

# Main frame of the app
<FrameScreen>:
    carousel: screen_selection
    orientation: 'vertical'
    md_bg_color: self.theme_cls.primary_light #self.theme_cls.primary_dark

    # Header for app
    MDAnchorLayout:
        anchor_x: 'center'
        anchor_y: 'top'
        size_hint_y: None
        height: 100  # 70 font size + 30 padding

        # Header label
        MDLabel:
            text: "Sudoku"
            font_style: "H3"
            bold: True
            font_size: 70
            padding: 15
            halign: "center"
            theme_text_color: "Primary"
            md_bg_color: "green"

    # Main content area
    MDBoxLayout:
        orientation: "vertical"
        size_hint_y: 0.9

        # Screen carousel
        MDCarousel:
            id: screen_selection
            direction: "right"
            scroll_timeout: 0
    # Footer for app
    MDAnchorLayout:
        anchor_x: 'center'
        anchor_y: 'bottom'
        size_hint_y: None
        height: 30 # 20 font size + 10 padding

        # Footer label
        MDLabel:
            id: footer
            text: "© 2025 Regina Reynolds"
            font_size: 20
            padding: 5
            halign: "center"
            theme_text_color: "Secondary"
            md_bg_color: "green"

# Difficulty selection screen
<DifficultyScreen>:
    options: difficulty_selection
    orientation: "vertical"
    size_hint: 1, 1

    # Header for difficulty selection
    MDLabel:
        text: "Select a difficulty"
        font_size: 50
        padding: 5
        halign: "center"

        adaptive_height: True
        theme_text_color: "Primary"

    # TODO: Set a maximum column width so that the cards aren't so far apart when the screen is resized.
    # Grid of difficulty cards
    MDGridLayout:
        id: difficulty_selection
        cols: 3
        orientation: "lr-tb"
        #spacing: "12dp"
        size_hint: (0.8, 1)
        pos_hint: {"center_x": 0.5}
        md_bg_color: "red"
        col_default_width: (self.width)/3
        cols_minimum: {0:200, 1:200, 2:200}  # Set minimum width for each column to card width
        padding: 0, (self.height - 215)/2  # (Height of grid - (height of card + height of card padding))/2
        spacing: (self.width-600)/6  # (Width of grid - (# of cards * width of a card))/(# of cards * 2) Divide width by 6 to get spacing when no padding

        # Easy card
        HoverCard:
            #size: self.parent.width/3 - (self.parent.padding[0]*2 + self.parent.spacing[0])/1.5
            difficulty_text: "Easy"
            difficulty_icon: "grid"
            difficulty_description: "Perfect for beginners"
            difficulty_color: "darkgreen"
            hover_color: [0.647, 0.839, 0.655, 1.0]  # Light green

        # Medium card
        HoverCard:
            difficulty_text: "Medium"
            difficulty_icon: "brain"
            difficulty_description: "A balanced challenge"
            difficulty_color: "orange"
            hover_color: [1.0, 0.8, 0.502, 1.0]  # Light orange

        # Hard card
        HoverCard:
            difficulty_text: "Hard"
            difficulty_icon: "trophy"
            difficulty_description: "For Sudoku experts"
            difficulty_color: "darkred"
            hover_color: [0.937, 0.604, 0.604, 1.0]  # Light red


# TODO: When horizontally resizing the progress bar page, the difficulty selection screen becomes visible.
<LoadingScreen>:
    progress: scraping_progress
    loading_text: "Scraping puzzle..."
    orientation: "vertical"
    size_hint: 1, 1

    # Loading screen label
    MDLabel:
        id: loading_text
        text: root.loading_text
        font_size: 50
        padding: 5
        halign: "center"

        adaptive_height: True
        theme_text_color: "Primary"

    # Loading screen progress bar grid layout for centering
    MDGridLayout:
        rows: 1
        size_hint: (0.8, 1)
        pos_hint: {"center_x": 0.5}
        md_bg_color: "purple"
        rows_minimum: {0: 4}  # Set minimum height to the height of the progress bar
        padding: 0, (self.height-4)/2  # (Height of grid - height of progress bar)/2

        # Loading screen progress bar
        MDProgressBar:
            id: scraping_progress
            size_hint: (0.8, None)
            pos_hint: {"center_x": 0.5}
            height: "4dp"
            max: 81
            color: app.theme_cls.accent_color
# TODO: fIX class redeclarations as specified in the warnings in the console
<PuzzleScreen>:
    board: boxes
    orientation: "vertical"
    size_hint: 1, 1
    radius: 10
    md_bg_color: "red"
    Board:
        id: boxes

        size_hint: .8, 1
        pos_hint: {"center_x": 0.5, "center_y": 0.5}
        row_default_height: (self.height/3)#(root.top-10)/3
        rows_minimum: {0: self.children[0].minimum_height, 1: self.children[0].minimum_height, 2: self.children[0].minimum_height}  # Set minimum height for each row to the height of one board chunk
        spacing: (self.width - (self.children[0].width*3))/6 # 50#, (self.height - (self.children[0].height*3))/6# -200)/2 #, (self.hei)

        theme_background_color: "Custom"
        md_bg_color: "purple"

        MDBoxLayout:
            md_bg_color:"blue"
            Board:
                theme_background_color: "Custom"
                md_bg_color: "green"
                Square:
                Square:
                Square:
                Square:
