#:kivy 1.0.9
#:import Color kivy.graphics.Color
#:import Rectangle kivy.graphics.Rectangle
#:import MDRaisedButton kivymd.uix.button.MDRaisedButton
#:import MDLabel kivymd.uix.label.MDLabel
#:import MDProgressBar kivymd.uix.progressbar.MDProgressBar
#:import MDCard kivymd.uix.card.MDCard
#:import MDIconButton kivymd.uix.button.MDIconButton

# Difficulty card widget
<DifficultyCard@MDCard>:
    orientation: 'vertical'
    adaptive_height: True
    size_hint: None, None
    size: "200dp", "200dp"

    style: "elevated"
    padding: ["0dp", "15dp", "0dp", "0dp"]  # Give top padding

    #ripple_behavior: True
    theme_background_color: "Custom"
    md_bg_color: root.difficulty_color

    theme_shadow_color: "Custom "
    shadow_color: root.difficulty_color
    # theme_bg_color: "Custom"
    # md_bg_color: "white"
    # md_bg_color_disabled: "grey"
    theme_shadow_offset: "Custom"
    shadow_offset: (1, -2)
    theme_shadow_softness: "Custom"
    shadow_softness: 1
    theme_elevation_level: "Custom"
    elevation_level: 2

    # Box layout to leave a color strip at the top of the card
    MDBoxLayout:
        orientation: "vertical"
        size_hint: None, None
        size: "200dp", "200dp"
        md_bg_color: app.theme_cls.bg_dark
        padding: "12dp"
        spacing: "12dp"

        radius:[0, 0, 16.0, 16.0]  # Give rounded corners to bottom of box layout to align with card

        # Card icon
        MDIconButton:
            id: difficulty_icon
            icon: root.difficulty_icon
            pos_hint: {"center_x": .5}
            theme_icon_color: "Custom"
            icon_color: 1, 1, 1, 1
            icon_size: "30dp"
            md_bg_color: root.difficulty_color  # Set icon background color

        # Difficulty label
        MDLabel:
            id: difficulty_text
            text: root.difficulty_text
            theme_text_color: "Custom"
            text_color: 1, 1, 1, 1
            font_style: "H5"
            bold: True
            halign: "center"
            adaptive_height: True

        # Difficulty description
        MDLabel:
            id: difficulty_description
            text: root.difficulty_description
            theme_text_color: "Custom"
            text_color: .9, .9, .9, 1
            halign: "center"
            adaptive_height: True

        # Start game button
        FocusButton:
            text: "Start Game"
            pos_hint: {"center_x": .5}
            theme_text_color: "Custom"
            text_color: 1, 1, 1, 1
            md_bg_color: root.difficulty_color
            unfocus_color: root.difficulty_color
            focus_color: root.hover_color


<HoverCard@DifficultyCard+HoverBehavior>:
    # on_enter: self.md_bg_color = [0, 0, 0, 0.2]
    # on_leave: self.md_bg_color = [0, 0, 0, 0.7]

<FocusButton+FocusBehavior>:


