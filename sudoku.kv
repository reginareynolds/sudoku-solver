#:kivy 1.0.9
#:import Gradient kivy_gradient.Gradient
#:import Color kivy.graphics.Color
#:import Rectangle kivy.graphics.Rectangle
#:import MDRaisedButton kivymd.uix.button.MDRaisedButton
#:import MDLabel kivymd.uix.label.MDLabel
#:import MDProgressBar kivymd.uix.progressbar.MDProgressBar
#:import MDCard kivymd.uix.card.MDCard
#:import MDIconButton kivymd.uix.button.MDIconButton

# Difficulty card widget
<DifficultyCard@MDCard>:
    orientation: 'vertical'
    adaptive_height: True
    size_hint: None, None
    size: "200dp", "200dp"

    style: "elevated"
    padding: ["0dp", "15dp", "0dp", "0dp"]  # Give top padding

    #ripple_behavior: True
    theme_background_color: "Custom"
    md_bg_color: root.difficulty_color

    theme_shadow_color: "Custom "
    shadow_color: root.difficulty_color
    # theme_bg_color: "Custom"
    # md_bg_color: "white"
    # md_bg_color_disabled: "grey"
    theme_shadow_offset: "Custom"
    shadow_offset: (1, -2)
    theme_shadow_softness: "Custom"
    shadow_softness: 1
    theme_elevation_level: "Custom"
    elevation_level: 2

    # Box layout to leave a color strip at the top of the card
    MDBoxLayout:
        orientation: "vertical"
        size_hint: None, None
        size: "200dp", "200dp"
        md_bg_color: app.theme_cls.bg_dark
        padding: "12dp"
        spacing: "12dp"

        radius:[0, 0, 16.0, 16.0]  # Give rounded corners to bottom of box layout to align with card

        # Card icon
        MDIconButton:
            id: difficulty_icon
            icon: root.difficulty_icon
            pos_hint: {"center_x": .5}
            theme_icon_color: "Custom"
            icon_color: 1, 1, 1, 1
            icon_size: "30dp"
            md_bg_color: root.difficulty_color  # Set icon background color

        # Difficulty label
        MDLabel:
            id: difficulty_text
            text: root.difficulty_text
            theme_text_color: "Custom"
            text_color: 1, 1, 1, 1
            font_style: "H5"
            bold: True
            halign: "center"
            adaptive_height: True

        # Difficulty description
        MDLabel:
            id: difficulty_description
            text: root.difficulty_description
            theme_text_color: "Custom"
            text_color: .9, .9, .9, 1
            halign: "center"
            adaptive_height: True

        # Start game button
        FocusButton:
            text: "Start Game"
            pos_hint: {"center_x": .5}
            theme_text_color: "Custom"
            text_color: 1, 1, 1, 1
            md_bg_color: root.difficulty_color
            unfocus_color: root.difficulty_color
            focus_color: root.hover_color


<HoverCard@DifficultyCard+HoverBehavior>:
    # on_enter: self.md_bg_color = [0, 0, 0, 0.2]
    # on_leave: self.md_bg_color = [0, 0, 0, 0.7]

<FocusButton+FocusBehavior>:



# Individual square on the board
<Square@Button>:
    top: root.top
    width: root.width

# 3x3 grid of squares
<Board@GridLayout>:
    top: root.top
    width: root.width
    cols: 3
    rows: 3
    padding: 2
    orientation: 'lr-tb'

# Main frame of the app
<FrameScreen>:
    carousel: screen_selection
    orientation: 'vertical'
    md_bg_color: self.theme_cls.bg_dark

    # Header for app
    MDAnchorLayout:
        anchor_x: 'center'
        anchor_y: 'top'
        size_hint_y: None
        height: 100  # 70 font size + 30 padding

        # Header label
        MDLabel:
            text: "Sudoku"
            font_style: "H3"
            bold: True
            font_size: 70
            padding: 15
            halign: "center"
            theme_text_color: "Primary"
            md_bg_color: "green"

    # Main content area
    MDBoxLayout:
        orientation: "vertical"
        size_hint_y: 0.9

        # Screen carousel
        MDCarousel:
            id: screen_selection
            direction: "right"
            scroll_timeout: 0
    # Footer for app
    MDAnchorLayout:
        anchor_x: 'center'
        anchor_y: 'bottom'
        size_hint_y: None
        height: 30 # 20 font size + 10 padding

        # Footer label
        MDLabel:
            id: footer
            text: "© 2025 Regina Reynolds"
            font_size: 20
            padding: 5
            halign: "center"
            theme_text_color: "Secondary"
            md_bg_color: "green"

# Difficulty selection screen
<DifficultyScreen>:
    options: difficulty_selection
    orientation: "vertical"
    size_hint: 1, 1

    # Header for difficulty selection
    MDLabel:
        text: "Select a difficulty"
        font_size: 50
        padding: 5
        halign: "center"

        adaptive_height: True
        theme_text_color: "Primary"

    # TODO: Set a maximum column width so that the cards aren't so far apart when the screen is resized.
    # Grid of difficulty cards
    MDGridLayout:
        id: difficulty_selection
        cols: 3
        orientation: "lr-tb"
        #spacing: "12dp"
        size_hint: (0.8, 1)
        pos_hint: {"center_x": 0.5}
        md_bg_color: "red"
        col_default_width: (self.width)/3
        cols_minimum: {0:200, 1:200, 2:200}  # Set minimum width for each column to card width
        padding: 0, (self.height - 215)/2  # (Height of grid - (height of card + height of card padding))/2
        spacing: (self.width-600)/6  # (Width of grid - (# of cards * width of a card))/(# of cards * 2) Divide width by 6 to get spacing when no padding

        # Easy card
        HoverCard:
            #size: self.parent.width/3 - (self.parent.padding[0]*2 + self.parent.spacing[0])/1.5
            difficulty_text: "Easy"
            difficulty_icon: "grid"
            difficulty_description: "Perfect for beginners"
            difficulty_color: "darkgreen"
            hover_color: [0.647, 0.839, 0.655, 1.0]  # Light green

        # Medium card
        HoverCard:
            difficulty_text: "Medium"
            difficulty_icon: "brain"
            difficulty_description: "A balanced challenge"
            difficulty_color: "orange"
            hover_color: [1.0, 0.8, 0.502, 1.0]  # Light orange

        # Hard card
        HoverCard:
            difficulty_text: "Hard"
            difficulty_icon: "trophy"
            difficulty_description: "For Sudoku experts"
            difficulty_color: "darkred"
            hover_color: [0.937, 0.604, 0.604, 1.0]  # Light red


# TODO: When horizontally resizing the progress bar page, the difficulty selection screen becomes visible.
<LoadingScreen>:
    progress: scraping_progress
    loading_text: "Scraping puzzle..."
    orientation: "vertical"
    size_hint: 1, 1

    # Loading screen label
    MDLabel:
        id: loading_text
        text: root.loading_text
        font_size: 50
        padding: 5
        halign: "center"

        adaptive_height: True
        theme_text_color: "Primary"

    # Loading screen progress bar grid layout for centering
    MDGridLayout:
        rows: 1
        size_hint: (0.8, 1)
        pos_hint: {"center_x": 0.5}
        md_bg_color: "purple"
        rows_minimum: {0: 4}  # Set minimum height to the height of the progress bar
        padding: 0, (self.height-4)/2  # (Height of grid - height of progress bar)/2

        # Loading screen progress bar
        MDProgressBar:
            id: scraping_progress
            size_hint: (0.8, None)
            pos_hint: {"center_x": 0.5}
            height: "4dp"
            max: 81
            color: app.theme_cls.accent_color

<PuzzleScreen>:
    board: boxes

    Board:
        id: boxes
        top: root.top
        width: root.width
        row_default_height: (root.top-10)/3
        padding: 5

        Board:
        Board:
        Board:
        Board:
        Board:
        Board:
        Board:
        Board:
        Board: